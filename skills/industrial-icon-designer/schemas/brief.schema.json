{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brief",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "set_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "redesign_mode": {
      "enum": [
        "normalize",
        "redraw",
        "reinterpret"
      ]
    },
    "semantic_approval": {
      "type": "boolean"
    },
    "sample_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "required_contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "platform"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "platform": {
            "enum": [
              "desktop",
              "web"
            ]
          },
          "removed_reason": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "set_id",
    "redesign_mode"
  ],
  "additionalProperties": true
}
